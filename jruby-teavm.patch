-        ChannelPumper(Ruby runtime, FileChannel inChannel, FileChannel outChannel, Slave slave, Object sync) {
-            if (DEBUG) out.println("using channel pumper");
-            this.inChannel = inChannel;
-            this.outChannel = outChannel;
