-            t2.interrupt();
-            t3.interrupt();
-        } catch (SecurityException se) {}
-
-        try { t1.join(); } catch (InterruptedException ie) {}
-        try { t2.join(); } catch (InterruptedException ie) {}
-        try { t3.join(); } catch (InterruptedException ie) {}
-    }
